# Ver docs/backend/variaveis-de-ambiente.md
# Em produção (Docker), MONGODB_URI e LIVEKIT_* vêm do infra/docker-compose.yml.
NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
LOG_LEVEL=info
TIMEZONE=America/Sao_Paulo
TRUST_PROXY=0

# Banco (dev local: infra/docker-compose.dev.yml)
MONGODB_URI=mongodb://localhost:27017/screem

# LiveKit (dev local: modo --dev)
LIVEKIT_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
