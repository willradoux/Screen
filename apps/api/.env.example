# Ver docs/backend/variaveis-de-ambiente.md
# Em produção (Docker), MONGODB_URI e LIVEKIT_* vêm do infra/docker-compose.yml.
NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
LOG_LEVEL=info
TIMEZONE=America/Sao_Paulo
TRUST_PROXY=0

# Banco (dev local: infra/docker-compose.dev.yml)
MONGODB_URI=mongodb://localhost:27017/screem

# LiveKit (dev local: modo --dev)
LIVEKIT_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Validade do token do LiveKit emitido no join (segundos)
JOIN_TOKEN_TTL_SECONDS=600

# Discord OAuth2 (Developer Portal > sua aplicação)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback
# Token do bot (Developer Portal > Bot). Vazio: a API sobe sem o bot (só em desenvolvimento).
DISCORD_BOT_TOKEN=
# Cargo marcado nos avisos de reunião. Vazio = @everyone.
MEETING_MENTION_ROLE_ID=
# Segundos com o canal de voz vazio antes de encerrar a live
EMPTY_LIVE_END_SECONDS=60
# Reunião aberta e vazia por tantos minutos é encerrada
EMPTY_MEETING_END_MINUTES=15
# De quanto em quanto tempo o agendador de reuniões verifica (segundos)
SCHEDULER_INTERVAL_SECONDS=15
# IDs Discord (separados por vírgula) que são ADMIN antes de configurar os cargos
BOOTSTRAP_ADMIN_IDS=

# Segredos (gere com: openssl rand -base64 32)
COOKIE_SECRET=troque-por-um-valor-aleatorio-com-32-ou-mais-caracteres
TOKEN_ENCRYPTION_KEY=
# Produção: domínio comum à API e ao frontend (ex.: .exemplo.com). Em dev deixe vazio.
SESSION_COOKIE_DOMAIN=
SESSION_TTL_DAYS=7
