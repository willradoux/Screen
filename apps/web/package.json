    "@material-symbols/svg-400": "^0.48.3",
    "@screem/shared": "*",
    "@usefluid/motion": "^0.1.2",
    "livekit-client": "^2.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.0",
