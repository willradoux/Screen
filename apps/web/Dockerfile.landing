# LP separada (só a TV), no subdomínio próprio. Contexto de build: raiz do repositório
#   docker build -f apps/web/Dockerfile.landing -t screen-landing \
#     --build-arg VITE_APP_URL=https://screen.exemplo.com \
#     --build-arg VITE_API_URL=https://api.exemplo.com/api/v1 .
# Usa o mesmo código da LP do app (apps/web/src/features/landing), num build à parte
# (landing.html): sem o roteador, o login nem o resto do app.
FROM node:22.23.4-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/web apps/web
COPY apps/api/package.json apps/api/package.json
ARG VITE_API_URL
ARG VITE_APP_URL
ENV VITE_API_URL=$VITE_API_URL VITE_APP_URL=$VITE_APP_URL VITE_LP_STANDALONE=true
RUN npm ci --ignore-scripts \
 && npm run build -w @screem/shared \
 && npm run build:landing -w @screem/web \
 && cd apps/web/dist-landing \
 && mv landing.html index.html \
 # O que é só do app (efeitos de câmera, service worker, filtro de microfone) não vai para a LP.
 && rm -rf mediapipe backgrounds sw.js noise-gate.worklet.js manifest.webmanifest

FROM nginx:1.27-alpine
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist-landing /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1/healthz || exit 1
