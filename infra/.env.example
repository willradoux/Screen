# Copie para infra/.env e preencha. Nunca commite o .env.
# Documentação: docs/infra/README.md

# Domínios (DNS apontando para o IP da VPS, sem proxy da Cloudflare)
API_DOMAIN=api.exemplo.com
LIVE_DOMAIN=live.exemplo.com
TURN_DOMAIN=turn.exemplo.com

# IP público da VPS (Coturn e LiveKit)
TURN_EXTERNAL_IP=203.0.113.10

# MongoDB
MONGO_USER=screem
MONGO_PASSWORD=troque-esta-senha

# LiveKit (gere com: openssl rand -hex 16 / openssl rand -base64 32)
LIVEKIT_API_KEY=troque-a-chave
LIVEKIT_API_SECRET=troque-o-segredo-com-32-ou-mais-caracteres

# Senha do usuário TURN usado pelo LiveKit (openssl rand -hex 24)
TURN_PASSWORD=troque-esta-senha-turn
