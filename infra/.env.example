# Copie para infra/.env na VPS e preencha. Nunca commite o .env.
# Passo a passo: docs/infra/migrar-do-coolify.md
# (Os valores atuais estão na aba "Environment Variables" do Coolify: copie de lá.)

# ---- Domínios (DNS de cada um apontando para o IP da VPS) ----
APP_DOMAIN=screen.exemplo.com
LANDING_DOMAIN=conheca.screen.exemplo.com
API_DOMAIN=api.screen.exemplo.com
LIVE_DOMAIN=live.screen.exemplo.com
TURN_DOMAIN=turn.screen.exemplo.com

# IP público da VPS (Coturn)
TURN_EXTERNAL_IP=203.0.113.10

# ---- Imagens (montadas pelo GitHub Actions) ----
IMAGE_REGISTRY=ghcr.io/willradoux
IMAGE_TAG=latest

# ---- Sessão e segredos da API ----
# Domínio do cookie de login: o domínio-pai do app e da API (com o ponto na frente).
SESSION_COOKIE_DOMAIN=.screen.exemplo.com
COOKIE_SECRET=troque-openssl-rand-hex-32
TOKEN_ENCRYPTION_KEY=troque-openssl-rand-base64-32
CORS_ORIGINS=

# ---- MongoDB ----
MONGO_USER=screem
MONGO_PASSWORD=troque-esta-senha

# ---- LiveKit (openssl rand -hex 16 / openssl rand -base64 32) ----
LIVEKIT_API_KEY=troque-a-chave
LIVEKIT_API_SECRET=troque-o-segredo-com-32-ou-mais-caracteres
# Senha do usuário TURN usado pelo LiveKit (openssl rand -hex 24)
TURN_PASSWORD=troque-esta-senha-turn

# ---- Discord ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
BOOTSTRAP_ADMIN_IDS=
OWNER_IDS=
ADMIN_ROLE_IDS=
MEETING_MENTION_ROLE_ID=

# ---- Opcionais (padrões entre parênteses) ----
# LOG_LEVEL=info
# TIMEZONE=America/Sao_Paulo
# SESSION_TTL_DAYS=7
# RECORDING_RETENTION_DAYS=10
